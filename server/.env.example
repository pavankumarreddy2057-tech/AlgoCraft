# AlgoCraft Server Environment Configuration

# Server Port (default 4000)
PORT=4000

# JWT Authentication Secret
JWT_SECRET=algocraft_super_secure_production_secret_key_2026

# ==============================================================================
# REAL EMAIL OTP SETTINGS (Choose Option A or Option B)
# ==============================================================================

# Option A: Gmail SMTP (Easiest - 100% Free)
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Name (e.g. "AlgoCraft") and copy the 16-character password
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="AlgoCraft Security" <your_email@gmail.com>

# Option B: Custom SMTP (SendGrid, Brevo, AWS SES, Mailgun, Postmark, Resend)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# SMTP_FROM="AlgoCraft Security" <noreply@sentinelhq.in>
